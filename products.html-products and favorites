* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  line-height: 1.6;
  color: #222;
  background: #fff;
}

header,
footer {
  padding: 20px;
  background: #f2f2f2;
  text-align: center;
}

h1,
h2,
h3 {
  line-height: 1.3;
}

nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 18px;
}

a {
  color: #222;
}

nav a[aria-current="page"] {
  font-weight: bold;
}

main {
  max-width: 1000px;
  margin: auto;
  padding: 24px;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
  margin: 20px auto;
}

figure {
  margin: 24px 0;
}

figcaption {
  text-align: center;
}

audio {
  max-width: 100%;
}

label {
  display: block;
  margin-top: 18px;
  font-weight: bold;
}

input,
select,
textarea {
  width: 100%;
  padding: 10px;
  font: inherit;
  border: 1px solid #666;
  border-radius: 4px;
}

form {
  max-width: 650px;
}

button,
.button {
  display: inline-block;
  padding: 10px 16px;
  border: 1px solid #222;
  border-radius: 4px;
  background: #222;
  color: #fff;
  font: inherit;
  text-decoration: none;
  cursor: pointer;
}

button[aria-pressed="true"] {
  background: #fff;
  color: #222;
}

.product-grid {
  display: grid;
  gap: 20px;
  margin: 24px 0;
}

.product-card {
  padding: 20px;
  border: 1px solid #aaa;
  border-radius: 4px;
}

.error {
  color: #a00000;
  margin: 4px 0;
}

[aria-invalid="true"] {
  border: 2px solid #a00000;
}

:focus-visible {
  outline: 3px solid #555;
  outline-offset: 3px;
}

@media (min-width: 700px) {
  .product-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  main {
    padding: 40px;
  }
}
"use strict";

